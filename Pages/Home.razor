@page "/"

@using TabBlazor

<PageTitle>InvestMoi</PageTitle>

<div class="container-xl py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-9 col-xl-8">

            <!-- CABEÇALHO -->
            <div class="text-center mb-5">

                <div class="home-logo mx-auto mb-3">
                    ↗
                </div>

                <h1 class="fw-bold mb-2">InvestMoi</h1>

                <p class="text-muted mb-0">
                    Meu painel pessoal de investimentos
                </p>

            </div>

            <!-- SOBRE O APLICATIVO -->
            <Card>

                <CardHeader>
                    <CardTitle>
                        Sobre o aplicativo
                    </CardTitle>
                </CardHeader>

                <CardBody>

                    <!-- AVISO IMPORTANTE -->
                    <div class="disclaimer-box mb-4">

                        <div class="disclaimer-icon">
                            ⚠
                        </div>

                        <div>
                            <h3 class="disclaimer-title">
                                Aviso importante
                            </h3>

                            <p class="disclaimer-text mb-0">
                                Este aplicativo não fornece recomendações de investimento,
                                aconselhamento financeiro ou indicações de compra e venda de ativos.
                            </p>
                        </div>

                    </div>

                    <!-- DESCRIÇÃO -->
                    <div class="home-section mb-4">

                        <h3 class="section-title">
                            <span class="section-number">01</span>
                            Objetivo do projeto
                        </h3>

                        <p class="text-muted lh-lg">
                            Este sistema foi desenvolvido exclusivamente para uso pessoal,
                            com o objetivo de organizar, visualizar e acompanhar ações
                            de interesse.
                        </p>

                        <p class="text-muted lh-lg mb-0">
                            A plataforma reúne indicadores e métodos de análise que
                            utilizo para facilitar o acompanhamento dos meus investimentos.
                        </p>

                    </div>

                    <hr class="my-4" />

                    <!-- INFORMAÇÕES -->
                    <div class="home-section mb-4">

                        <h3 class="section-title">
                            <span class="section-number">02</span>
                            Como interpretar as informações
                        </h3>

                        <p class="text-muted lh-lg mb-0">
                            Os dados, cálculos e classificações apresentados refletem
                            minhas próprias preferências, estratégias e critérios de análise.
                            Eles servem apenas como ferramentas de consulta e organização.
                        </p>

                    </div>

                    <hr class="my-4" />

                    <!-- DECISÕES -->
                    <div class="decision-box">

                        <div class="decision-icon">
                            ℹ
                        </div>

                        <div>
                            <div class="fw-bold mb-1">
                                Decisões conscientes
                            </div>

                            <div class="text-muted small lh-lg">
                                Cada investidor deve realizar suas próprias análises,
                                considerar seu perfil de risco e avaliar cuidadosamente
                                antes de tomar qualquer decisão financeira.
                            </div>
                        </div>

                    </div>

                </CardBody>

            </Card>

            <!-- RODAPÉ -->
            <div class="text-center text-muted small mt-4">
                InvestMoi · Painel pessoal de investimentos
            </div>

        </div>

    </div>

</div>

<style>

    /* CABEÇALHO */

    .home-logo {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: #206bc4;
        color: white;
        font-size: 36px;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(32, 107, 196, 0.18);
    }

    /* AVISO IMPORTANTE */

    .disclaimer-box {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        padding: 20px;
        background: #fff3cd;
        border: 1px solid #ffca2c;
        border-left: 5px solid #e6a700;
        border-radius: 8px;
    }

    .disclaimer-icon {
        flex-shrink: 0;
        font-size: 28px;
        color: #9a6700;
        line-height: 1.2;
    }

    .disclaimer-title {
        color: #664d03;
        font-size: 16px;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .disclaimer-text {
        color: #664d03;
        font-size: 13px;
        line-height: 1.7;
        font-weight: 500;
    }

    /* SEÇÕES */

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #182433;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .section-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 27px;
        height: 27px;
        flex-shrink: 0;
        border-radius: 7px;
        background: #eaf2fc;
        color: #206bc4;
        font-size: 11px;
        font-weight: 800;
    }

    /* DECISÕES CONSCIENTES */

    .decision-box {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        padding: 16px;
        background: #f5f8fc;
        border: 1px solid #e5edf7;
        border-radius: 8px;
    }

    .decision-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        flex-shrink: 0;
        border-radius: 8px;
        background: #e3efff;
        color: #206bc4;
        font-size: 19px;
        font-weight: 700;
    }

</style>