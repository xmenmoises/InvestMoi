@page "/Acao/{Codigo}"

@using System.Text.Json
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using TabBlazor

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>@Nome - @Codigo | InvestMoi</PageTitle>

<div class="container-xl py-4">

    @if (carregando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <div class="text-muted mt-3">Carregando informações...</div>
        </div>
    }
    else if (!string.IsNullOrEmpty(erro))
    {
        <div class="alert alert-danger">@erro</div>
        <button class="btn btn-outline-secondary" @onclick="Voltar">
            Voltar
        </button>
    }
    else
    {
        <!-- CABEÇALHO -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

            <!-- IDENTIFICAÇÃO -->
            <div>
                <button class="btn btn-sm btn-outline-secondary mb-3"
                        @onclick="Voltar">
                    <i class="ti ti-arrow-left"></i> Voltar
                </button>

                <h1 class="mb-1">@Codigo</h1>

                <div class="text-muted">@Nome</div>

            </div>

            <!-- COTAÇÃO E ATUALIZAÇÃO -->
            <div class="d-flex flex-column align-items-end gap-2">

                @if (PrecoAtual > 0)
                {
                    <div class="card shadow-sm">
                        <div class="card-body py-3 px-4">

                            <div class="subheader">
                                Cotação atual
                            </div>

                            <div class="d-flex align-items-center gap-2">

                                <span class="h1 mb-0">
                                    @FormatarMoeda(PrecoAtual)
                                </span>

                            </div>

                        </div>
                    </div>
                }

                <button class="btn btn-primary order-first"
                        @onclick="Atualizar"
                        disabled="@atualizando">
                    @(atualizando ? "Atualizando..." : "Atualizar")
                </button>

            </div>

        </div>


        <!-- FUNDAMENTOS DA EMPRESA -->
        @if (Fundamentos.HasValue &&
             Fundamentos.Value.ValueKind == JsonValueKind.Object)
        {
            <Card class="mb-4">

                <CardHeader>
                    <CardTitle>Fundamentos da empresa</CardTitle>
                </CardHeader>

                <CardBody>

                    <!-- IDENTIFICAÇÃO -->
                    @if (TemCampos("Tipo", "Setor", "Subsetor"))
                    {
                        <div class="mb-4">
                            <h3 class="mb-3">Identificação</h3>

                            <div class="row g-3">
                                @foreach (var campo in ObterCampos("Tipo", "Setor", "Subsetor"))
                                {
                                    <div class="col-6 col-md-4 col-lg-3">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted small mb-1">
                                                @FormatarNome(campo.Nome)
                                            </div>
                                            <div class="h3 mb-0">
                                                @FormatarValor(campo.Nome, campo.Valor)
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- VALUATION -->
                    @if (TemCampos("P_L", "P_VP", "P_EBIT", "PSR",
                                 "P_Ativos", "P_Cap_Giro", "P_Ativ_Circ_Liq"))
                    {
                        <div class="mb-4">
                            <hr />
                            <h3 class="mb-3">Valuation</h3>

                            <div class="row g-3">
                                @foreach (var campo in ObterCampos(
                                    "P_L", "P_VP", "P_EBIT", "PSR",
                                    "P_Ativos", "P_Cap_Giro", "P_Ativ_Circ_Liq"))
                                {
                                    <div class="col-6 col-md-4 col-lg-3">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted small mb-1">
                                                @FormatarNome(campo.Nome)
                                            </div>
                                            <div class="h3 mb-0">
                                                @FormatarValor(campo.Nome, campo.Valor)
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- INDICADORES -->
                    @if (TemCampos("Div_Yield", "EV_EBITDA", "EV_EBIT", "LPA", "VPA"))
                    {
                        <div class="mb-4">
                            <hr />
                            <h3 class="mb-3">Indicadores</h3>

                            <div class="row g-3">
                                @foreach (var campo in ObterCampos(
                                    "Div_Yield", "EV_EBITDA", "EV_EBIT", "LPA", "VPA"))
                                {
                                    <div class="col-6 col-md-4 col-lg-3">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted small mb-1">
                                                @FormatarNome(campo.Nome)
                                            </div>
                                            <div class="h3 mb-0">
                                                @FormatarValor(campo.Nome, campo.Valor)
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- CRESCIMENTO E MARGENS -->
                    @if (TemCampos("Cres_Rec_5a", "Marg_Bruta",
                                 "Marg_EBIT", "Marg_Liquida"))
                    {
                        <div class="mb-4">
                            <hr />
                            <h3 class="mb-3">Crescimento e margens</h3>

                            <div class="row g-3">
                                @foreach (var campo in ObterCampos(
                                    "Cres_Rec_5a", "Marg_Bruta",
                                    "Marg_EBIT", "Marg_Liquida"))
                                {
                                    <div class="col-6 col-md-4 col-lg-3">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted small mb-1">
                                                @FormatarNome(campo.Nome)
                                            </div>
                                            <div class="h3 mb-0">
                                                @FormatarValor(campo.Nome, campo.Valor)
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- RENTABILIDADE -->
                    @if (TemCampos("EBIT_Ativo", "ROIC", "ROE", "Giro_Ativos"))
                    {
                        <div class="mb-4">
                            <hr />
                            <h3 class="mb-3">Rentabilidade</h3>

                            <div class="row g-3">
                                @foreach (var campo in ObterCampos(
                                    "EBIT_Ativo", "ROIC", "ROE", "Giro_Ativos"))
                                {
                                    <div class="col-6 col-md-4 col-lg-3">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted small mb-1">
                                                @FormatarNome(campo.Nome)
                                            </div>
                                            <div class="h3 mb-0">
                                                @FormatarValor(campo.Nome, campo.Valor)
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- LIQUIDEZ E ENDIVIDAMENTO -->
                    @if (TemCampos("Liquidez_Corr", "Div_Liq_Patrim"))
                    {
                        <div class="mb-4">
                            <hr />
                            <h3 class="mb-3">Liquidez e endividamento</h3>

                            <div class="row g-3">
                                @foreach (var campo in ObterCampos(
                                    "Liquidez_Corr", "Div_Liq_Patrim"))
                                {
                                    <div class="col-6 col-md-4 col-lg-3">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted small mb-1">
                                                @FormatarNome(campo.Nome)
                                            </div>
                                            <div class="h3 mb-0">
                                                @FormatarValor(campo.Nome, campo.Valor)
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- BALANÇO -->
                    @if (TemCampos("Valor_de_mercado", "Valor_da_firma",
                                 "Nro_Acoes", "Ativo", "Disponibilidades",
                                 "Ativo_Circulante", "Div_Bruta", "Div_Liquida",
                                 "Patrim_Liq"))
                    {
                        <div class="mb-4">
                            <hr />
                            <h3 class="mb-3">Balanço patrimonial</h3>

                            <div class="row g-3">
                                @foreach (var campo in ObterCampos(
                                    "Valor_de_mercado", "Valor_da_firma",
                                    "Nro_Acoes", "Ativo", "Disponibilidades",
                                    "Ativo_Circulante", "Div_Bruta",
                                    "Div_Liquida", "Patrim_Liq"))
                                {
                                    <div class="col-6 col-md-4 col-lg-3">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted small mb-1">
                                                @FormatarNome(campo.Nome)
                                            </div>
                                            <div class="h3 mb-0">
                                                @FormatarValor(campo.Nome, campo.Valor)
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- RESULTADOS -->
                    @if (TemCampos(
                        "Receita_Liquida_Ultimos_12_Meses",
                        "EBIT_Ultimos_12_Meses",
                        "Lucro_Liquido_Ultimos_12_Meses",
                        "Receita_Liquida_Ultimos_3_Meses",
                        "EBIT_Ultimos_3_Meses",
                        "Lucro_Liquido_Ultimos_3_Meses"))
                    {
                        <div class="mb-4">
                            <hr />
                            <h3 class="mb-3">Resultados financeiros</h3>

                            <div class="row g-3">
                                @foreach (var campo in ObterCampos(
                                    "Receita_Liquida_Ultimos_12_Meses",
                                    "EBIT_Ultimos_12_Meses",
                                    "Lucro_Liquido_Ultimos_12_Meses",
                                    "Receita_Liquida_Ultimos_3_Meses",
                                    "EBIT_Ultimos_3_Meses",
                                    "Lucro_Liquido_Ultimos_3_Meses"))
                                {
                                    <div class="col-6 col-md-4 col-lg-3">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted small mb-1">
                                                @FormatarNome(campo.Nome)
                                            </div>
                                            <div class="h3 mb-0">
                                                @FormatarValor(campo.Nome, campo.Valor)
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- ATUALIZAÇÃO -->
                    @if (TemCampos("Ult_balanco_processado"))
                    {
                        <div>
                            <hr />
                            <h3 class="mb-3">Atualização</h3>

                            <div class="row g-3">
                                @foreach (var campo in ObterCampos("Ult_balanco_processado"))
                                {
                                    <div class="col-6 col-md-4 col-lg-3">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted small mb-1">
                                                @FormatarNome(campo.Nome)
                                            </div>
                                            <div class="h3 mb-0">
                                                @FormatarValor(campo.Nome, campo.Valor)
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                </CardBody>
            </Card>
        }

        <!-- ANÁLISES -->
        <h2 class="mb-3">Análises de investimento</h2>

        <div class="row row-cards mb-4">

            <!-- BARSI -->
            <div class="col-lg-12">

                <Card>

                    <CardHeader>
                        <CardTitle>Análise Barsi</CardTitle>
                    </CardHeader>

                    <CardBody>

                        <div class="row g-3">

                            <div class="col-6">
                                <div class="subheader">Média dos dividendos</div>
                                <div class="h2">@FormatarMoeda(MediaDividendos)</div>
                            </div>

                            <div class="col-6">
                                <div class="subheader">DY desejado</div>
                                <div class="h2">@DYPadrao.ToString("N2", Cultura)%</div>
                            </div>

                            <div class="col-12">
                                <hr />
                                <div class="subheader">Preço-teto Barsi</div>
                                <div class="h1 text-success">
                                    @FormatarMoeda(PrecoTetoBarsi)
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="subheader">PT / PM</div>
                                <div class="h3">@RelacaoBarsi.ToString("N2", Cultura)</div>
                            </div>

                            <div class="col-6">
                                <div class="subheader">Diferença</div>
                                <div class="h3 @ClasseDiferencaBarsi">
                                    @DiferencaBarsi.ToString("+0.00;-0.00;0.00")%
                                </div>
                            </div>

                        </div>

                        <hr />

                        <div class="subheader mb-2">Classificação</div>

                        <span class="badge @ClasseBadge(ViesBarsi)">
                            @ViesBarsi
                        </span>

                        
                        @if (Dividendos.Count > 0)
                        {
                            <hr />

                            <div class="subheader mb-3">
                                Histórico de dividendos por ação
                            </div>

                            <div class="grafico-dividendos-scroll">

                                <div class="grafico-dividendos">

                                    @foreach (var item in Dividendos.OrderBy(x => x.Key))
                                    {
                                        <div class="dividendo-item">

                                            <div class="dividendo-valor">
                                                @item.Value.ToString("F3", Cultura)
                                            </div>

                                            <div class="dividendo-barra-area">

                                                <div class="barra-dividendo"
                                                     title="@($"{item.Key}: {item.Value.ToString("F3", Cultura)}")"
                                                     style="height:@AlturaDividendo(item.Value)">
                                                </div>

                                            </div>

                                            <div class="dividendo-ano">
                                                @item.Key
                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>

                            <div class="text-muted small mt-2">
                                Valores em reais por ação.
                            </div>
                        }


                    </CardBody>

                </Card>

            </div>

            <!-- GRAHAM -->
            <div class="col-lg-12">

                <Card>

                    <CardHeader>
                        <CardTitle>Análise Graham</CardTitle>
                    </CardHeader>

                    <CardBody>

                        <div class="row g-3">

                            <div class="col-12">
                                <div class="subheader">Valor intrínseco</div>
                                <div class="h1">
                                    @FormatarMoeda(ValorIntrinseco)
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="subheader">Margem de segurança</div>
                                <div class="h3">
                                    @MargemSeguranca.ToString("N2", Cultura)%
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="subheader">Preço-teto</div>
                                <div class="h3 text-success">
                                    @FormatarMoeda(PrecoTetoGraham)
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="subheader">PT / PM</div>
                                <div class="h3">@RelacaoGraham.ToString("N2", Cultura)</div>
                            </div>

                            <div class="col-6">
                                <div class="subheader">Diferença</div>
                                <div class="h3 @ClasseDiferencaGraham">
                                    @DiferencaGraham.ToString("+0.00;-0.00;0.00")%
                                </div>
                            </div>

                        </div>

                        <hr />

                        <div class="subheader mb-2">Classificação</div>

                        <span class="badge @ClasseBadge(ViesGraham)">
                            @ViesGraham
                        </span>

                    </CardBody>

                </Card>

            </div>

        </div>

                    

        <div class="text-muted small mt-3">
            Cotações e histórico fornecidos pela brapi.dev.

            @if (ultimaAtualizacao.HasValue)
            {
                <span>
                    Última atualização:
                    @ultimaAtualizacao.Value.ToString("dd/MM/yyyy HH:mm:ss").
                </span>
            }
        </div>
    }

</div>

<style>

    .grafico-precos {
        width: 100%;
        height: 260px;
    }

    .grafico-svg {
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .grafico-dividendos {
        height: 160px;
    }

    .barra-dividendo-container {
        height: 105px;
        display: flex;
        align-items: end;
        justify-content: center;
    }

    .barra-dividendo {
        width: 70%;
        min-height: 2px;
        background: var(--tblr-primary);
        border-radius: 4px 4px 0 0;
    }

    .bg-comprar {
        background: #ffeb00 !important;
        color: #000 !important;
    }

    .bg-orange {
        background: #f59f00 !important;
        color: #000 !important;
    }

    .text-orange {
        color: #f59f00 !important;
    }

    @@media(max-width: 576px) {
        .grafico-precos {
            height: 190px;
        }

        .grafico-dividendos {
            overflow-x: auto;
            min-width: 0;
        }
    }

    .grafico-dividendos-scroll {
        width: 100%;
        overflow-x: auto;
        padding-bottom: 8px;
    }

    .grafico-dividendos {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        min-width: 620px;
        height: 155px;
        border-bottom: 1px solid var(--tblr-border-color);
    }

    .dividendo-item {
        flex: 1;
        min-width: 28px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
    }

    .dividendo-valor {
        font-size: 10px;
