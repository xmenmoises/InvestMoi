    // ==========================================
    // GRÁFICO HISTÓRICO DE PREÇOS
    // ==========================================

    private class PontoHistorico
    {
        public DateTime Data { get; set; }
        public double Preco { get; set; }
    }

    private List<PontoHistorico> Historico = new();

    private string periodoSelecionado = "1y";

    private readonly Dictionary<string, string> Periodos = new()
    {
        ["1D"] = "1d",
        ["1M"] = "1mo",
        ["6M"] = "6mo",
        ["1A"] = "1y",
        ["5A"] = "5y",
        ["Máx."] = "max"
    };

    private string PontosGrafico
    {
        get
        {
            if (Historico.Count < 2)
                return "";

            double min = Historico.Min(x => x.Preco);
            double max = Historico.Max(x => x.Preco);
            double amplitude = max - min;

            if (amplitude == 0)
                amplitude = 1;

            return string.Join(" ",
                Historico.Select((x, i) =>
                {
                    double px =
                        i * 800.0 / (Historico.Count - 1);

                    double py =
                        220 - ((x.Preco - min) / amplitude * 180);

                    return
                        $"{px.ToString("F1", CultureInfo.InvariantCulture)}," +
                        $"{py.ToString("F1", CultureInfo.InvariantCulture)}";
                }));
        }
    }

    private string PontosArea =>
        string.IsNullOrEmpty(PontosGrafico)
            ? ""
            : $"0,220 {PontosGrafico} 800,220";

