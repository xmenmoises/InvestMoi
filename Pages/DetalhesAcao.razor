    // Formatação dinâmica dos valores
    private string FormatarValor(string nome, JsonElement valor)
    {
        if (valor.ValueKind == JsonValueKind.Number)
        {
            double numero = valor.GetDouble();

            bool percentual =
                nome.Contains("dy", StringComparison.OrdinalIgnoreCase) ||
                nome.Contains("yield", StringComparison.OrdinalIgnoreCase) ||
                nome.Contains("roe", StringComparison.OrdinalIgnoreCase) ||
                nome.Contains("roa", StringComparison.OrdinalIgnoreCase) ||
                nome.Contains("margem", StringComparison.OrdinalIgnoreCase);

            return numero.ToString("N2", Cultura) +
                (percentual ? "%" : "");
        }

        return valor.ValueKind switch
        {
            JsonValueKind.String =>
                valor.GetString() ?? "--",

            JsonValueKind.True => "Sim",
            JsonValueKind.False => "Não",
            JsonValueKind.Null => "--",

            _ => valor.ToString()
        };
    }

    // Altura das barras do gráfico de dividendos
    private string AlturaDividendo(double valor)
    {
        double maximo = Dividendos.Values.DefaultIfEmpty(0).Max();

        if (maximo <= 0)
            return "3px";

        double altura = Math.Max(3, (valor / maximo) * 100);

        return $"{altura:F1}px";
    }

