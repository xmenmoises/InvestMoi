    // ==========================================
    // CAMPOS DOS FUNDAMENTOS
    // ==========================================

    private List<(string Nome, JsonElement Valor)> ObterCampos(
        params string[] nomes)
    {
        var resultado = new List<(string Nome, JsonElement Valor)>();

        if (!Fundamentos.HasValue)
            return resultado;

        foreach (var nome in nomes)
        {
            if (Fundamentos.Value.TryGetProperty(nome, out var valor))
            {
                if (valor.ValueKind == JsonValueKind.Null ||
                    valor.ValueKind == JsonValueKind.Undefined)
                    continue;

                if (valor.ValueKind == JsonValueKind.String &&
                    string.IsNullOrWhiteSpace(valor.GetString()))
                    continue;

                resultado.Add((nome, valor));
            }
        }

        return resultado;
    }

    private bool TemCampos(params string[] nomes)
    {
        return ObterCampos(nomes).Count > 0;
    }

