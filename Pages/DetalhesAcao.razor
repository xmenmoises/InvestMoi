        border-radius: 4px 4px 0 0;
    }

    .dividendo-ano {
        font-size: 10px;
        margin-top: 7px;
        color: var(--tblr-secondary-color);
    }

</style>


@code {

    private static readonly CultureInfo Cultura =
        CultureInfo.GetCultureInfo("pt-BR");

    [Parameter]
    public string Codigo { get; set; } = "";

    private string Nome = "";

    private bool carregando = true;
    private bool atualizando;
    private string? erro;

    private DateTime? ultimaAtualizacao;

    private JsonElement? dados;
    private JsonElement? Fundamentos;

    private readonly HashSet<string> CamposIgnorados =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "Codigo",
            "Nome",
            "Setor",
            "Analise_Barsi",
            "Analise_Graham",
            "Fundamentos"
        };

    // ==========================================
    // CONFIGURAÇÕES
    // ==========================================

    private class Configuracoes
    {
        [JsonPropertyName("Analise_Barsi")]
        public BarsiConfig Barsi { get; set; } = new();

        [JsonPropertyName("Analise_Graham")]
        public GrahamConfig Graham { get; set; } = new();

        [JsonPropertyName("Vies")]
        public Dictionary<string, double> Vies { get; set; } = new();
    }

    private class BarsiConfig
    {
        [JsonPropertyName("DY_Padrao")]
        public double DY { get; set; }
    }

    private class GrahamConfig
    {
        [JsonPropertyName("Fator_Valor_Intrinseco")]
        public double Fator { get; set; }

        [JsonPropertyName("Margem_Seguranca")]
        public double Margem { get; set; }
    }

    private Configuracoes Parametros = new();

    private double DYPadrao => Parametros.Barsi.DY;

    private double MargemSeguranca =>
        Parametros.Graham.Margem;

    // ==========================================
    // DADOS DAS ANÁLISES
    // ==========================================

    private Dictionary<string, double> Dividendos = new();

    private double LPA;
    private double VPA;

    // Média de todos os dividendos disponíveis no JSON
    private double MediaDividendos =>
        Dividendos.Count > 0
            ? Dividendos.Values.Average()
            : 0;

    // Preço-teto Barsi
    private double PrecoTetoBarsi =>
        DYPadrao > 0
            ? MediaDividendos / (DYPadrao / 100)
            : 0;

    // Valor intrínseco Graham
    private double ValorIntrinseco =>
        LPA > 0 && VPA > 0 && Parametros.Graham.Fator > 0
            ? Math.Sqrt(
                Parametros.Graham.Fator * LPA * VPA
              )
            : 0;

    // Preço-teto Graham
    private double PrecoTetoGraham =>
        ValorIntrinseco > 0
            ? ValorIntrinseco * (1 - MargemSeguranca / 100)
            : 0;

    // ==========================================
    // COTAÇÃO
    // ==========================================

    private double PrecoAtual;
    private double Variacao;
    private double MaximaDia;
    private double MinimaDia;
    private double FechamentoAnterior;

    private string ClasseVariacao =>
        Variacao >= 0 ? "text-success" : "text-danger";

    // ==========================================
    // CLASSIFICAÇÕES
    // ==========================================

    private double RelacaoBarsi =>
        PrecoAtual > 0
            ? PrecoTetoBarsi / PrecoAtual
            : 0;

    private double RelacaoGraham =>
        PrecoAtual > 0
            ? PrecoTetoGraham / PrecoAtual
            : 0;

    private double DiferencaBarsi =>
        RelacaoBarsi > 0
            ? (RelacaoBarsi - 1) * 100
            : 0;

    private double DiferencaGraham =>
        RelacaoGraham > 0
            ? (RelacaoGraham - 1) * 100
            : 0;

    private string ClasseDiferencaBarsi =>
        DiferencaBarsi >= 0
            ? "text-success"
            : "text-danger";

    private string ClasseDiferencaGraham =>
        DiferencaGraham >= 0
            ? "text-success"
            : "text-danger";

    private string ViesBarsi =>
        Classificar(RelacaoBarsi);

    private string ViesGraham =>
        Classificar(RelacaoGraham);

    private string ViesGeral
    {
        get
        {
            if (ViesBarsi == "AGUARDANDO" ||
                ViesGraham == "AGUARDANDO")
                return "AGUARDANDO";

            double media =
                (Pontuar(ViesBarsi) + Pontuar(ViesGraham)) / 2;

            if (media >= 2.5) return "COMPRAR FORTE";
            if (media >= 1.75) return "COMPRAR";
            if (media >= 1.25) return "COMPRAR FRACO";

            return "MANTER";
        }
    }

    private string Classificar(double relacao)
    {
        // Sem cotação não existe classificação
        if (PrecoAtual <= 0 || relacao <= 0)
            return "AGUARDANDO";

        if (Parametros.Vies.TryGetValue(
            "COMPRAR FORTE", out var comprarForte) &&
            relacao >= comprarForte)
            return "COMPRAR FORTE";

        if (Parametros.Vies.TryGetValue(
            "COMPRAR", out var comprar) &&
            relacao >= comprar)
            return "COMPRAR";

        if (Parametros.Vies.TryGetValue(
            "COMPRAR FRACO", out var comprarFraco) &&
            relacao > comprarFraco)
            return "COMPRAR FRACO";

        return "MANTER";
    }

    private double Pontuar(string vies) =>
        vies switch
        {
            "COMPRAR FORTE" => 3,
            "COMPRAR" => 2,
            "COMPRAR FRACO" => 1,
            "MANTER" => 0,
            _ => 0
        };

    private string ClasseBadge(string vies) =>
        vies switch
        {
            "COMPRAR FORTE" => "bg-success text-dark",
            "COMPRAR" => "bg-comprar",
            "COMPRAR FRACO" => "bg-orange text-dark",
            "MANTER" => "bg-danger text-dark",
