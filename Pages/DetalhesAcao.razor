    private async Task CarregarTudo()
    {
        try
        {
            carregando = true;
            erro = null;

            await CarregarParametros();
            await CarregarAcao();
            await CarregarCotacao();

        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            carregando = false;
        }
    }

    // ==========================================
    // CARREGAR PARÂMETROS
    // ==========================================

    private async Task CarregarParametros()
    {
        Parametros = await Http.GetFromJsonAsync<Configuracoes>(
            "data/configuracoes/parametros.json"
        ) ?? throw new Exception(
            "Não foi possível carregar os parâmetros."
        );

        if (Parametros.Graham.Fator <= 0)
            throw new Exception(
                "Fator de Graham não encontrado nos parâmetros."
            );

        if (Parametros.Barsi.DY <= 0)
            throw new Exception(
                "DY padrão do Barsi não encontrado nos parâmetros."
            );
    }

    // ==========================================
    // CARREGAR AÇÃO DO JSON
    // ==========================================

    private async Task CarregarAcao()
    {
        var json = await Http.GetStringAsync(
            $"data/acoes/{Uri.EscapeDataString(Codigo)}.json"
        );

        using var documento = JsonDocument.Parse(json);

        dados = documento.RootElement.Clone();

        var raiz = dados.Value;

        // Limpa dados anteriores
        Dividendos.Clear();
        LPA = 0;
        VPA = 0;
        Fundamentos = null;

        Nome = raiz.TryGetProperty("Nome", out var nome)
            ? nome.GetString() ?? Codigo
            : Codigo;

        // --------------------------------------
        // ANÁLISE BARSI
        // --------------------------------------

        if (raiz.TryGetProperty(
            "Analise_Barsi", out var barsi) &&
            barsi.ValueKind == JsonValueKind.Object &&
            barsi.TryGetProperty(
                "Dividendos", out var dividendos) &&
            dividendos.ValueKind == JsonValueKind.Object)
        {
            Dividendos = dividendos.EnumerateObject()
                .Where(x =>
                    x.Value.ValueKind == JsonValueKind.Number)
                .ToDictionary(
                    x => x.Name,
                    x => x.Value.GetDouble()
                );
        }

        // --------------------------------------
        // ANÁLISE GRAHAM
        // --------------------------------------

        if (raiz.TryGetProperty(
            "Analise_Graham", out var graham) &&
            graham.ValueKind == JsonValueKind.Object)
        {
            if (graham.TryGetProperty("LPA", out var lpa) &&
                lpa.ValueKind == JsonValueKind.Number)
            {
                LPA = lpa.GetDouble();
            }

            if (graham.TryGetProperty("VPA", out var vpa) &&
                vpa.ValueKind == JsonValueKind.Number)
            {
                VPA = vpa.GetDouble();
            }
        }

        // --------------------------------------
        // FUNDAMENTOS DINÂMICOS
        // --------------------------------------

        if (raiz.TryGetProperty(
            "Fundamentos", out var fundamentos) &&
            fundamentos.ValueKind == JsonValueKind.Object)
        {
            Fundamentos = fundamentos.Clone();
        }
    }

    // ==========================================
    // COTAÇÃO BRAPI - MESMO PADRÃO DA TELA BARSI
    // ==========================================

    private class BrapiListResponse
    {
        [JsonPropertyName("stocks")]
        public List<BrapiStock>? Stocks { get; set; }

        [JsonPropertyName("totalPages")]
        public int TotalPages { get; set; }
    }

    private class BrapiStock
    {
        [JsonPropertyName("stock")]
        public string? StockCode { get; set; }

        [JsonPropertyName("close")]
        public double? Close { get; set; }

        [JsonPropertyName("change")]
        public double? Change { get; set; }
    }

    private async Task CarregarCotacao()
    {
        try
        {
            erro = null;

            double? precoEncontrado = null;
            double? variacaoEncontrada = null;

            int pagina = 1;

            while (true)
            {
                var url =
                    $"https://brapi.dev/api/quote/list?limit=100&type=stock&page={pagina}&sortBy=close&sortOrder=asc";

                var response =
                    await Http.GetFromJsonAsync<BrapiListResponse>(url);

                if (response?.Stocks == null ||
                    response.Stocks.Count == 0)
                    break;

                var acao = response.Stocks.FirstOrDefault(
                    x => string.Equals(
                        x.StockCode,
                        Codigo,
                        StringComparison.OrdinalIgnoreCase
                    )
                );

                if (acao != null)
                {
                    precoEncontrado = acao.Close;
                    variacaoEncontrada = acao.Change;
                    break;
                }

                if (pagina >= response.TotalPages)
                    break;

                pagina++;
            }

            if (precoEncontrado == null || precoEncontrado <= 0)
                throw new Exception(
                    $"{Codigo} não encontrada na brapi.dev."
                );

            PrecoAtual = precoEncontrado.Value;
            Variacao = variacaoEncontrada ?? 0;

            ultimaAtualizacao = DateTime.Now;
        }
        catch (Exception ex)
        {
            PrecoAtual = 0;
            Variacao = 0;
            erro = $"Erro ao consultar cotação: {ex.Message}";
        }
    }


