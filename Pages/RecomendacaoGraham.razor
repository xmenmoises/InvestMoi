@page "/RecomendacaoGraham"

@using System.Text.Json.Serialization
@using System.Net.Http.Json
@using System.Globalization
@using TabBlazor

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Recomendações Graham</PageTitle>

<div class="container-xl py-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Recomendações Graham</h1>
            <div class="text-muted">
                Análise de ações baseada no valor justo e margem de segurança.
            </div>
        </div>

        <button class="btn btn-primary"
                @onclick="AtualizarCotacoes"
                disabled="@carregando">

            @(carregando ? " Atualizando... " : " Atualizar ")
        </button>
    </div>

    <!-- STATUS -->
    @if (carregando)
    {
        <div class="alert alert-info">
            Consultando cotações na brapi.dev...
        </div>
    }

    @if (!string.IsNullOrEmpty(erro))
    {
        <div class="alert alert-danger">
            @erro
        </div>
    }

    <!-- TABELA -->
    <Card>

        <CardHeader>
            <CardTitle>Lista de ações</CardTitle>
        </CardHeader>

        <CardBody>

            <div class="table-responsive acoes-responsive">

                <table class="table table-vcenter table-hover acoes-table">

                    <thead>
                        <tr>
                            <th>Ação</th>
                            <th class="text-end d-none d-md-table-cell">LPA</th>
                            <th class="text-end d-none d-md-table-cell">VPA</th>
                            <th class="text-end d-none d-md-table-cell">PJ</th>
                            <th class="text-center">PM</th>
                            <th class="text-end d-none d-md-table-cell">MS (%)</th>
                            <th class="text-end d-none d-md-table-cell">PT</th>
                            <th class="text-end d-none d-md-table-cell">PT / PM</th>
                            <th class="text-center">Viés</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var acao in Acoes.OrderBy(x => x.PM))
                        {
                            <tr style="cursor:pointer"
                                @onclick="() => AbrirAcao(acao.Codigo)">

                                <!-- AÇÃO -->
                                <td>
                                    <strong>@acao.Codigo</strong>
                                    <div class="text-muted small">
                                        @acao.Nome
                                    </div>
                                </td>

                                <!-- LPA -->
                                <td class="text-end d-none d-md-table-cell">
                                    @acao.LPA.ToString("N2", Cultura)
                                </td>

                                <!-- VPA -->
                                <td class="text-end d-none d-md-table-cell">
                                    @acao.VPA.ToString("N2", Cultura)
                                </td>

                                <!-- VALOR JUSTO -->
                                <td class="text-end d-none d-md-table-cell">
                                    @FormatarMoeda(acao.PJ)
                                </td>

                                <!-- PREÇO DE MERCADO -->
                                <td class="text-end">
                                    @if (acao.TemCotacao)
                                    {
                                        <strong>@FormatarMoeda(acao.PM)</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>

                                <!-- MARGEM DE SEGURANÇA -->
                                <td class="text-end d-none d-md-table-cell">
                                    @acao.MS.ToString("N2", Cultura)
                                </td>

                                <!-- PREÇO TETO -->
                                <td class="text-end d-none d-md-table-cell text-success fw-bold">
                                    @FormatarMoeda(acao.PT)
                                </td>

                                <!-- PT / PM -->
                                <td class="text-end d-none d-md-table-cell">
                                    @if (acao.TemCotacao && acao.PM > 0)
                                    {
                                        <strong>
                                            @acao.Relacao.ToString("N2", Cultura)
                                        </strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>

                                <!-- VIÉS -->
                                <td class="text-center">
                                    @if (acao.TemCotacao && acao.PM > 0)
                                    {
                                        var vies = CalcularVies(acao);

                                        <span class="badge @ClasseBadge(vies)">
                                            @vies
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            AGUARDANDO
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </CardBody>

    </Card>

    <!-- LEGENDA -->
    <Card class="mt-4">

        <CardBody>

            <div class="d-flex flex-wrap gap-4">

                <div>
                    <span class="badge bg-info text-dark">PM</span>
                    <span class="text-muted small ms-1">Preço no Mercado (Preço Atual)</span>
                </div>

                <div>
                    <span class="badge bg-success text-dark">COMPRAR FORTE</span>
                    <span class="text-muted small ms-1">PT/PM ≥ 2,00</span>
                </div>

                <div>
                    <span class="badge bg-comprar">COMPRAR</span>
                    <span class="text-muted small ms-1">PT/PM ≥ 1,49</span>
                </div>

                <div>
                    <span class="badge bg-orange text-dark">COMPRAR FRACO</span>
                    <span class="text-muted small ms-1">PT/PM &gt; 1,00</span>
                </div>

                <div>
                    <span class="badge bg-danger text-dark">MANTER</span>
                    <span class="text-muted small ms-1">PT/PM ≤ 1,00</span>
                </div>

            </div>

        </CardBody>

    </Card>

    <div class="text-muted small mt-3">

        Cotação atualizada pela brapi.dev.

        @if (ultimaAtualizacao != null)
        {
            <span>
                Última atualização:
                @ultimaAtualizacao.Value.ToString("dd/MM/yyyy HH:mm:ss").
            </span>
        }

    </div>

</div>

<style>

    .text-orange {
        color: #f59f00 !important;
    }

    .bg-orange {
        background-color: #f59f00 !important;
    }

    .table th {
        white-space: nowrap;
    }

    .table td {
        white-space: nowrap;
    }

    .badge {
        color: #000 !important;
        font-weight: 600;
    }

    .bg-comprar {
        background-color: #ffeb00 !important;
        color: #000 !important;
    }

    /* TABELA MOBILE */
    @@media (max-width: 767.98px) {

        .acoes-responsive {
            overflow-x: hidden !important;
            width: 100%;
        }

        .acoes-table {
            width: 100% !important;
            min-width: 0 !important;
            table-layout: fixed;
            margin-bottom: 0;
        }
            /* Largura das colunas */
            .acoes-table th:nth-child(1),
            .acoes-table td:nth-child(1) {
                width: 40%;
            }

            .acoes-table th:nth-child(2),
            .acoes-table td:nth-child(2) {
                width: 25%;
            }

            .acoes-table th:nth-child(7),
            .acoes-table td:nth-child(7) {
                width: 35%;
            }
            /* Reduz espaçamento interno */
            .acoes-table th,
            .acoes-table td {
                padding: 0.65rem 0.35rem !important;
                font-size: 12px;
            }
                /* Valores */
                .acoes-table td:nth-child(2) {
                    white-space: nowrap;
                    font-size: 11px;
                }
            /* Badges */
            .acoes-table .badge {
                font-size: 10px;
                padding: 0.3rem 0.4rem;
                white-space: nowrap;
            }
    }

</style>

@code {

    private static readonly CultureInfo Cultura =
        CultureInfo.GetCultureInfo("pt-BR");

    // ==========================================
    // PARÂMETROS DO JSON
    // ==========================================

    private class ParametrosConfig
    {
        [JsonPropertyName("Analise_Graham")]
        public AnaliseGrahamConfig AnaliseGraham { get; set; } = new();

        [JsonPropertyName("Vies")]
        public Dictionary<string, double> Vies { get; set; } = new();
    }

    private class AnaliseGrahamConfig
    {
        [JsonPropertyName("Fator_Valor_Intrinseco")]
        public double Fator_Valor_Intrinseco { get; set; }

        [JsonPropertyName("Margem_Seguranca")]
        public double Margem_Seguranca { get; set; }
    }

    private ParametrosConfig Parametros = new()
    {
        AnaliseGraham = new()
        {
            Fator_Valor_Intrinseco = 22.5
        },
        Vies = new()
        {
            ["COMPRAR FORTE"] = 2.00,
            ["COMPRAR"] = 1.49,
            ["COMPRAR FRACO"] = 1.00,
            ["MANTER"] = 0.99
        }
    };

    private async Task CarregarParametros()
    {
        var parametros =
            await Http.GetFromJsonAsync<ParametrosConfig>(
                "data/configuracoes/parametros.json"
            );

        if (parametros == null)
            throw new Exception("Não foi possível carregar parametros.json.");

        if (parametros.AnaliseGraham.Fator_Valor_Intrinseco <= 0)
            throw new Exception("Fator de valor intrínseco inválido.");

        if (parametros.AnaliseGraham.Margem_Seguranca < 0 || parametros.AnaliseGraham.Margem_Seguranca >= 100)
            throw new Exception("Margem de segurança deve estar entre 0 e 100.");

        string[] chaves =
        {
            "COMPRAR FORTE",
            "COMPRAR",
            "COMPRAR FRACO",
            "MANTER"
        };

        foreach (var chave in chaves)
        {
            if (!parametros.Vies.ContainsKey(chave))
                throw new Exception($"Parâmetro de viés ausente: {chave}");
        }

        Parametros = parametros;
    }

    // ==========================================
    // MODELO DOS ARQUIVOS JSON
    // ==========================================

    private class AcaoGraham
    {
        [JsonPropertyName("Codigo")]
        public string Codigo { get; set; } = "";

        [JsonPropertyName("Nome")]
        public string Nome { get; set; } = "";

        [JsonPropertyName("Analise_Graham")]
        public DadosGraham AnaliseGraham { get; set; } = new();

        // Dados fundamentalistas vindos do JSON

        public double LPA => AnaliseGraham.LPA;

        public double VPA => AnaliseGraham.VPA;

        // Valores calculados em tempo de execução

        // Valor justo de Graham
        public double PJ =>
            LPA > 0 && VPA > 0
                ? Math.Sqrt(
                    FatorIntrinseco * LPA * VPA
                  )
                : 0;

        // Margem de segurança
        public double MS { get; set; }

        // Preço-teto
        public double PT =>
            PJ > 0
                ? PJ * (1 - MS / 100)
                : 0;

        // Preço de mercado atualizado pela API
        public double PM { get; set; }

        public bool TemCotacao { get; set; }

        // Relação entre preço-teto e preço de mercado
        public double Relacao =>
            TemCotacao && PM > 0
                ? PT / PM
                : 0;

        // Fator utilizado no cálculo
        public double FatorIntrinseco { get; set; }
    }

    private class DadosGraham
    {
        [JsonPropertyName("LPA")]
        public double LPA { get; set; }

        [JsonPropertyName("VPA")]
        public double VPA { get; set; }
    }

    // ==========================================
    // LISTA DINÂMICA DE AÇÕES
    // ==========================================

    private List<AcaoGraham> Acoes = new();

    private async Task CarregarAcoes()
    {
        Acoes.Clear();

        // Carrega índice de ações
        var codigos = await Http.GetFromJsonAsync<List<string>>(
            "data/acoes/index.json"
        );

        if (codigos == null || codigos.Count == 0)
            throw new Exception("Nenhuma ação encontrada em index.json.");

        var codigosUnicos = codigos
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase);

        foreach (var codigo in codigosUnicos)
        {
            try
            {
                // Carrega JSON individual
                var acao = await Http.GetFromJsonAsync<AcaoGraham>(
                    $"data/acoes/{codigo}.json"
                );

                if (acao == null)
                    continue;

                if (string.IsNullOrWhiteSpace(acao.Codigo))
                    continue;

                // Aplica o fator configurado
                acao.FatorIntrinseco =
                    Parametros.AnaliseGraham.Fator_Valor_Intrinseco;

                // Aplica margem de segurança configurada no JSON
                acao.MS = Parametros.AnaliseGraham.Margem_Seguranca;

                // Só adiciona ações com dados válidos
                if (acao.LPA <= 0 || acao.VPA <= 0)
                {
                    Console.WriteLine(
                        $"Dados Graham inválidos para {codigo}."
                    );

                    continue;
                }

                Acoes.Add(acao);
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    $"Erro ao carregar {codigo}.json: {ex.Message}"
                );
            }
        }

        if (Acoes.Count == 0)
            throw new Exception(
                "Nenhuma ação com dados Graham válidos foi encontrada."
            );
    }

    // ==========================================
    // CLASSIFICAÇÃO DINÂMICA
    // ==========================================

    private string CalcularVies(AcaoGraham acao)
    {
        if (!acao.TemCotacao || acao.PM <= 0)
            return "AGUARDANDO";

        double relacao = acao.Relacao;

        double comprarForte = Parametros.Vies["COMPRAR FORTE"];
        double comprar = Parametros.Vies["COMPRAR"];
        double comprarFraco = Parametros.Vies["COMPRAR FRACO"];

        if (relacao >= comprarForte)
            return "COMPRAR FORTE";

        if (relacao >= comprar)
            return "COMPRAR";

        if (relacao > comprarFraco)
            return "COMPRAR FRACO";

        return "MANTER";
    }

    // ==========================================
    // CLASSIFICAÇÃO VISUAL
    // ==========================================

    private string ClasseBadge(string vies)
    {
        return vies switch
        {
            "COMPRAR FORTE" => "bg-success text-dark",
            "COMPRAR" => "bg-comprar",
            "COMPRAR FRACO" => "bg-orange text-dark",
            "MANTER" => "bg-danger text-dark",
            _ => "bg-secondary text-dark"
        };
    }

    // ==========================================
    // FORMATAÇÃO
    // ==========================================

    private string FormatarMoeda(double valor)
    {
        return valor.ToString("C2", Cultura);
    }

    // ==========================================
    // INICIALIZAÇÃO
    // ==========================================

    private bool carregando;
    private string? erro;
    private DateTime? ultimaAtualizacao;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            carregando = true;

            // 1. Carrega parâmetros
            await CarregarParametros();

            // 2. Carrega ações dos JSONs
            await CarregarAcoes();

            // 3. Consulta cotações
            await ConsultarCotacoes();
        }
        catch (Exception ex)
        {
            erro = $"Erro ao inicializar recomendações: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }
    }

    // ==========================================
    // ATUALIZAÇÃO MANUAL
    // ==========================================

    private async Task AtualizarCotacoes()
    {
        if (carregando)
            return;

        try
        {
            carregando = true;
            erro = null;

            // Recarrega parâmetros
            await CarregarParametros();

            // Recarrega os JSONs das ações
            await CarregarAcoes();

            // Atualiza cotações
            await ConsultarCotacoes();
        }
        catch (Exception ex)
        {
            erro = $"Erro ao atualizar: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }
    }

    // ==========================================
    // API BRAPI
    // ==========================================

    private async Task ConsultarCotacoes()
    {
        var codigosDesejados = Acoes
            .Select(x => x.Codigo)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var codigosEncontrados = new HashSet<string>(
            StringComparer.OrdinalIgnoreCase
        );

        int pagina = 1;
        int totalPaginas = 1;

        while (pagina <= totalPaginas)
        {
            var url =
                $"https://brapi.dev/api/quote/list?limit=100&type=stock&page={pagina}&sortBy=close&sortOrder=asc";

            var response =
                await Http.GetFromJsonAsync<ApiResponse>(url);

            if (response?.Stocks == null)
                break;

            totalPaginas = response.TotalPages;

            foreach (var stock in response.Stocks)
            {
                if (string.IsNullOrWhiteSpace(stock.StockCode))
                    continue;

                if (!codigosDesejados.Contains(stock.StockCode))
                    continue;

                var acao = Acoes.FirstOrDefault(
                    x => string.Equals(
                        x.Codigo,
                        stock.StockCode,
                        StringComparison.OrdinalIgnoreCase
                    )
                );

                if (acao == null || !stock.Close.HasValue)
                    continue;

                // Atualiza somente o preço de mercado
                acao.PM = stock.Close.Value;
                acao.TemCotacao = true;

                codigosEncontrados.Add(stock.StockCode);
            }

            if (codigosEncontrados.Count == codigosDesejados.Count)
                break;

            pagina++;
        }

        var naoEncontradas = codigosDesejados
            .Except(codigosEncontrados)
            .ToList();

        if (naoEncontradas.Any())
        {
            erro = "Não foi possível atualizar: " +
                   string.Join(", ", naoEncontradas);
        }

        ultimaAtualizacao = DateTime.Now;
    }

    // ==========================================
    // MODELOS DA API
    // ==========================================

    public class ApiResponse
    {
        [JsonPropertyName("stocks")]
        public List<Stock>? Stocks { get; set; }

        [JsonPropertyName("totalPages")]
        public int TotalPages { get; set; }
    }

    public class Stock
    {
        [JsonPropertyName("stock")]
        public string? StockCode { get; set; }

        [JsonPropertyName("close")]
        public double? Close { get; set; }
    }

    private void AbrirAcao(string codigo)
    {
        Navigation.NavigateTo($"/Acao/{codigo}");
    }

}