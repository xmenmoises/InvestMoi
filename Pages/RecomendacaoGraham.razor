@page "/RecomendacaoGraham"

@using System.Text.Json.Serialization
@using System.Net.Http.Json
@using System.Globalization
@using TabBlazor

@inject HttpClient Http

<PageTitle>Recomendações Graham</PageTitle>

<div class="container-xl py-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Recomendações Graham</h1>
            <div class="text-muted">
                Análise de ações baseada no valor justo e margem de segurança.
            </div>
        </div>

        <button class="btn btn-primary"
                @onclick="AtualizarCotacoes"
                disabled="@carregando">

            @(carregando ? " Atualizando... " : " Atualizar ")
        </button>
    </div>

    <!-- STATUS -->
    @if (carregando)
    {
        <div class="alert alert-info">
            Consultando cotações na brapi.dev...
        </div>
    }

    @if (!string.IsNullOrEmpty(erro))
    {
        <div class="alert alert-danger">
            @erro
        </div>
    }

    <!-- TABELA -->
    <Card>

        <CardHeader>
            <CardTitle>Lista de ações</CardTitle>
        </CardHeader>

        <CardBody>

            <div class="table-responsive">

                <table class="table table-vcenter table-hover">

                    <thead>
                        <tr>
                            <th>Ação</th>
                            <th class="text-end d-none d-md-table-cell">LPA</th>
                            <th class="text-end d-none d-md-table-cell">VPA</th>
                            <th class="text-end d-none d-md-table-cell">PJ</th>
                            <th class="text-center">PM</th>
                            <th class="text-end d-none d-md-table-cell">MS (%)</th>
                            <th class="text-end d-none d-md-table-cell">PT</th>
                            <th class="text-end d-none d-md-table-cell">PT / PM</th>
                            <th class="text-center">Viés</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var acao in Acoes.OrderBy(x => x.PM ?? 0))
                        {
                            <tr>

                                <!-- AÇÃO -->
                                <td>
                                    <strong>@acao.Codigo</strong>
                                    <div class="text-muted small">
                                        @acao.Nome
                                    </div>
                                </td>

                                <!-- LPA -->
                                <td class="text-end d-none d-md-table-cell">
                                    @acao.LPA.ToString("N2", Cultura)
                                </td>

                                <!-- VPA -->
                                <td class="text-end d-none d-md-table-cell">
                                    @acao.VPA.ToString("N2", Cultura)
                                </td>

                                <!-- VALOR JUSTO -->
                                <td class="text-end d-none d-md-table-cell">
                                    @FormatarMoeda(acao.PJ)
                                </td>

                                <!-- PREÇO DE MERCADO -->
                                <td class="text-end">
                                    @if (acao.PM.HasValue)
                                    {
                                        <strong>@FormatarMoeda(acao.PM.Value)</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>

                                <!-- MARGEM DE SEGURANÇA -->
                                <td class="text-end d-none d-md-table-cell">
                                    @acao.MS.ToString("N2", Cultura)
                                </td>

                                <!-- PREÇO TETO -->
                                <td class="text-end d-none d-md-table-cell text-success fw-bold">
                                    @FormatarMoeda(acao.PT)
                                </td>

                                <!-- PT / PM -->
                                <td class="text-end d-none d-md-table-cell">
                                    @if (acao.PM.HasValue && acao.PM.Value > 0)
                                    {
                                        <strong>
                                            @acao.Relacao.ToString("N2", Cultura)
                                        </strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>

                                <!-- VIÉS -->
                                <td class="text-center">
                                    @if (acao.PM.HasValue && acao.PM.Value > 0)
                                    {
                                        <span class="badge @ClasseBadge(acao.Vies)">
                                            @acao.Vies
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            AGUARDANDO
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </CardBody>

    </Card>

    <!-- LEGENDA -->
    <Card class="mt-4">

        <CardBody>

            <div class="d-flex flex-wrap gap-4">

                <div>
                    <span class="badge bg-info text-dark">PM</span>
                    <span class="text-muted small ms-1">Preço no Mercado (Preço Atual)</span>
                </div>

                <div>
                    <span class="badge bg-success text-dark">COMPRAR FORTE</span>
                    <span class="text-muted small ms-1">PT/PM ≥ 2,00</span>
                </div>

                <div>
                    <span class="badge bg-comprar">COMPRAR</span>
                    <span class="text-muted small ms-1">PT/PM ≥ 1,49</span>
                </div>

                <div>
                    <span class="badge bg-orange text-dark">COMPRAR FRACO</span>
                    <span class="text-muted small ms-1">PT/PM &gt; 1,00</span>
                </div>

                <div>
                    <span class="badge bg-danger text-dark">MANTER</span>
                    <span class="text-muted small ms-1">PT/PM ≤ 1,00</span>
                </div>

            </div>

        </CardBody>

    </Card>

    <div class="text-muted small mt-3">

        Fundamentos e margem de segurança fixos conforme planilha.
        Cotação atualizada pela brapi.dev.

        @if (ultimaAtualizacao != null)
        {
            <span>
                Última atualização:
                @ultimaAtualizacao.Value.ToString("dd/MM/yyyy HH:mm:ss").
            </span>
        }

    </div>

</div>

<style>

    .text-orange {
        color: #f59f00 !important;
    }

    .bg-orange {
        background-color: #f59f00 !important;
    }

    .table th {
        white-space: nowrap;
    }

    .table td {
        white-space: nowrap;
    }

    .badge {
        color: #000 !important;
        font-weight: 600;
    }

    .bg-comprar {
        background-color: #ffeb00 !important;
        color: #000 !important;
    }

</style>

@code {

    private static readonly CultureInfo Cultura =
        CultureInfo.GetCultureInfo("pt-BR");

    // ==========================================
    // DADOS FIXOS DA PLANILHA
    // ==========================================

    private List<AcaoGraham> Acoes = new()
    {
        new()
        {
            Codigo = "KLBN4",
            Nome = "Klabin PN",
            LPA = 0.09,
            VPA = 1.52,
            PJ = 1.75,
            MS = 20.00,
            PT = 1.40
        },

        new()
        {
            Codigo = "POMO3",
            Nome = "Marcopolo ON",
            LPA = 1.00,
            VPA = 3.25,
            PJ = 8.55,
            MS = 20.00,
            PT = 6.84
        },

        new()
        {
            Codigo = "CMIN3",
            Nome = "CSN Mineração",
            LPA = 0.41,
            VPA = 1.30,
            PJ = 3.46,
            MS = 20.00,
            PT = 2.77
        },

        new()
        {
            Codigo = "REDE3",
            Nome = "Rede Energia",
            LPA = 0.44,
            VPA = 2.43,
            PJ = 4.90,
            MS = 20.00,
            PT = 3.92
        },

        new()
        {
            Codigo = "BMGB4",
            Nome = "Banco BMG",
            LPA = 0.96,
            VPA = 6.66,
            PJ = 11.99,
            MS = 20.00,
            PT = 9.60
        },

        new()
        {
            Codigo = "SAPR4",
            Nome = "Sanepar PN",
            LPA = 0.81,
            VPA = 8.40,
            PJ = 12.37,
            MS = 20.00,
            PT = 9.90
        },

        new()
        {
            Codigo = "BEES3",
            Nome = "Banestes ON",
            LPA = 1.29,
            VPA = 7.02,
            PJ = 14.27,
            MS = 20.00,
            PT = 11.42
        },

        new()
        {
            Codigo = "AURE3",
            Nome = "Auren Energia",
            LPA = 0.10,
            VPA = 10.96,
            PJ = 4.97,
            MS = 20.00,
            PT = 3.97
        },

        new()
        {
            Codigo = "CPLE3",
            Nome = "Copel ON",
            LPA = 0.91,
            VPA = 7.99,
            PJ = 12.79,
            MS = 20.00,
            PT = 10.23
        }
    };

    // ==========================================
    // MODELO E CÁLCULOS DINÂMICOS
    // ==========================================

    private class AcaoGraham
    {
        public string Codigo { get; set; } = "";
        public string Nome { get; set; } = "";

        public double LPA { get; set; }
        public double VPA { get; set; }

        public double PJ { get; set; }
        public double MS { get; set; }
        public double PT { get; set; }

        // Único valor atualizado pela API
        public double? PM { get; set; }

        public double Relacao =>
            PM.HasValue && PM.Value > 0
                ? PT / PM.Value
                : 0;

        public string Vies =>
            !PM.HasValue || PM.Value <= 0 ? "AGUARDANDO" :
            Relacao >= 2.00 ? "COMPRAR FORTE" :
            Relacao >= 1.49 ? "COMPRAR" :
            Relacao > 1.00 ? "COMPRAR FRACO" :
            "MANTER";
    }

    // ==========================================
    // CLASSIFICAÇÃO VISUAL
    // ==========================================

    private string ClasseBadge(string vies)
    {
        return vies switch
        {
            "COMPRAR FORTE" => "bg-success text-dark",
            "COMPRAR" => "bg-comprar",
            "COMPRAR FRACO" => "bg-orange text-dark",
            "MANTER" => "bg-danger text-dark",
            _ => "bg-secondary text-dark"
        };
    }

    // ==========================================
    // FORMATAÇÃO
    // ==========================================

    private string FormatarMoeda(double valor)
    {
        return valor.ToString("C2", Cultura);
    }

    // ==========================================
    // API BRAPI
    // ==========================================

    private bool carregando;
    private string? erro;
    private DateTime? ultimaAtualizacao;

    protected override async Task OnInitializedAsync()
    {
        await AtualizarCotacoes();
    }

    private async Task AtualizarCotacoes()
    {
        try
        {
            carregando = true;
            erro = null;

            var codigosEncontrados = new HashSet<string>();

            var codigosDesejados = Acoes
                .Select(x => x.Codigo)
                .ToHashSet();

            int pagina = 1;
            int totalPaginas = 1;

            while (pagina <= totalPaginas)
            {
                var url =
                    $"https://brapi.dev/api/quote/list?limit=100&type=stock&page={pagina}&sortBy=close&sortOrder=asc";

                var response =
                    await Http.GetFromJsonAsync<ApiResponse>(url);

                if (response?.Stocks == null)
                    break;

                totalPaginas = response.TotalPages;

                foreach (var stock in response.Stocks)
                {
                    if (stock.StockCode == null)
                        continue;

                    if (!codigosDesejados.Contains(stock.StockCode))
                        continue;

                    var acao = Acoes.FirstOrDefault(
                        x => x.Codigo == stock.StockCode);

                    if (acao == null || !stock.Close.HasValue)
                        continue;

                    // Atualiza somente o preço de mercado
                    acao.PM = stock.Close.Value;

                    codigosEncontrados.Add(stock.StockCode);
                }

                if (codigosEncontrados.Count == codigosDesejados.Count)
                    break;

                pagina++;
            }

            var naoEncontradas = codigosDesejados
                .Except(codigosEncontrados)
                .ToList();

            if (naoEncontradas.Any())
            {
                erro = "Não foi possível atualizar: " +
                       string.Join(", ", naoEncontradas);
            }

            ultimaAtualizacao = DateTime.Now;
        }
        catch (Exception ex)
        {
            erro = $"Erro ao consultar brapi.dev: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }
    }

    // ==========================================
    // MODELOS DA API
    // ==========================================

    public class ApiResponse
    {
        [JsonPropertyName("stocks")]
        public List<Stock>? Stocks { get; set; }

        [JsonPropertyName("totalPages")]
        public int TotalPages { get; set; }
    }

    public class Stock
    {
        [JsonPropertyName("stock")]
        public string? StockCode { get; set; }

        [JsonPropertyName("close")]
        public double? Close { get; set; }
    }

}